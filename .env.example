# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Canonical URL used for metadata (OG tags, canonical, etc.)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# -----------------------------------------------------------------------------
# Meta / Facebook Pixel + Conversions API
# -----------------------------------------------------------------------------
# Pixel ID (exposed to the browser). Used by the client-side Pixel.
NEXT_PUBLIC_META_PIXEL_ID=""

# Same Pixel ID used server-side by the Conversions API.
# You can leave this empty and only set NEXT_PUBLIC_META_PIXEL_ID.
META_PIXEL_ID=""

# System User access token with `ads_management` for the Pixel.
# Generate in Business Manager > Events Manager > Conversions API.
META_CAPI_ACCESS_TOKEN=""

# Optional. Fill with a test code (from Events Manager > Test Events)
# while validating server events. Leave empty in production.
META_CAPI_TEST_EVENT_CODE=""

# -----------------------------------------------------------------------------
# MailerLite (email marketing / auto-sequence)
# -----------------------------------------------------------------------------
# API Key from MailerLite → Integrations → API → Developer API.
MAILERLITE_API_KEY=""

# Optional. The group ID to add subscribers to (Masterclass Leads list).
# Found in MailerLite → Subscribers → Groups → click a group → ID in the URL.
MAILERLITE_GROUP_ID=""

# -----------------------------------------------------------------------------
# Resend (transactional email — Email 1 access link delivery)
# -----------------------------------------------------------------------------
# API Key from resend.com → API Keys. Domain must be verified in Resend.
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# Supabase (lead storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
# Server-only. NEVER expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=""
